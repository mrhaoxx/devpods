[
  {"name": "plain name", "content": "name: ${NAME}",
   "vars": [{"name": "NAME", "builtin": true, "required": true}],
   "values": {"NAME": "a-b"}, "rendered": "name: a-b"},
  {"name": "default used", "content": "image: ${IMAGE:-ubuntu:24.04}",
   "vars": [{"name": "IMAGE", "builtin": false, "required": false, "default": "ubuntu:24.04"}],
   "values": {}, "rendered": "image: ubuntu:24.04"},
  {"name": "default overridden", "content": "image: ${IMAGE:-ubuntu:24.04}",
   "vars": [{"name": "IMAGE", "builtin": false, "required": false, "default": "ubuntu:24.04"}],
   "values": {"IMAGE": "debian"}, "rendered": "image: debian"},
  {"name": "empty default", "content": "gpu: '${GPU:-}'",
   "vars": [{"name": "GPU", "builtin": false, "required": false}],
   "values": {}, "rendered": "gpu: ''"},
  {"name": "repeated: first default wins everywhere", "content": "${A} ${A:-x} ${A:-y}",
   "vars": [{"name": "A", "builtin": false, "required": false, "default": "x"}],
   "values": {}, "rendered": "x x x"},
  {"name": "order of first appearance", "content": "${B_2} ${A} ${B_2}",
   "vars": [{"name": "B_2", "builtin": false, "required": true}, {"name": "A", "builtin": false, "required": true}],
   "values": {"A": "1", "B_2": "2"}, "rendered": "2 1 2"},
  {"name": "shell text is left alone", "content": "echo ${home} ${1} ${a.b} ${_X} $X ${X-y} ${}",
   "vars": [], "values": {}, "rendered": "echo ${home} ${1} ${a.b} ${_X} $X ${X-y} ${}"},
  {"name": "escape", "content": "$${X} and $$${Y} and ${Z}",
   "vars": [{"name": "Z", "builtin": false, "required": true}],
   "values": {"Z": "v"}, "rendered": "${X} and $${Y} and v"},
  {"name": "values are not rescanned", "content": "a: ${X}",
   "vars": [{"name": "X", "builtin": false, "required": true}],
   "values": {"X": "${Y} $${Z}"}, "rendered": "a: ${Y} $${Z}"},
  {"name": "unterminated", "content": "a: ${X and ${Y:-z",
   "vars": [], "values": {}, "rendered": "a: ${X and ${Y:-z"},
  {"name": "builtins", "content": "${OWNER} ${NAME} ${NODE} ${INDEX}",
   "vars": [{"name": "OWNER", "builtin": true, "required": false}, {"name": "NAME", "builtin": true, "required": true},
            {"name": "NODE", "builtin": true, "required": true}, {"name": "INDEX", "builtin": true, "required": false}],
   "values": {"OWNER": "u", "NAME": "u-a", "NODE": "n", "INDEX": "1"}, "rendered": "u u-a n 1"},
  {"name": "server-filled builtins are still needed to render", "content": "${OWNER} ${INDEX}",
   "vars": [{"name": "OWNER", "builtin": true, "required": false}, {"name": "INDEX", "builtin": true, "required": false}],
   "values": {}, "error": "missing:OWNER,INDEX"},
  {"name": "missing", "content": "${X} ${Y:-1} ${Z}",
   "vars": [{"name": "X", "builtin": false, "required": true}, {"name": "Y", "builtin": false, "required": false, "default": "1"},
            {"name": "Z", "builtin": false, "required": true}],
   "values": {}, "error": "missing:X,Z"},
  {"name": "unknown", "content": "${X}",
   "vars": [{"name": "X", "builtin": false, "required": true}],
   "values": {"X": "1", "Z": "2", "B": "3"}, "error": "unknown:B,Z"},
  {"name": "newline in a value", "content": "${X}",
   "vars": [{"name": "X", "builtin": false, "required": true}],
   "values": {"X": "a\nb"}, "error": "value:X"},
  {"name": "control character in a value", "content": "${X}",
   "vars": [{"name": "X", "builtin": false, "required": true}],
   "values": {"X": "a\u0007b"}, "error": "value:X"},
  {"name": "tab in a value", "content": "${X}",
   "vars": [{"name": "X", "builtin": false, "required": true}],
   "values": {"X": "a\tb"}, "error": "value:X"},
  {"name": "unicode value", "content": "t: ${X}",
   "vars": [{"name": "X", "builtin": false, "required": true}],
   "values": {"X": "八卡 整机"}, "rendered": "t: 八卡 整机"}
]
